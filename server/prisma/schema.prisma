// Generates the Prisma Client as TypeScript code inside our project
generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    ADMIN
    CLIENT
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    password  String
    role      Role     @default(CLIENT)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
